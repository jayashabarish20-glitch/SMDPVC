DATABASE_URL=sqlite+aiosqlite:///./data/smdpvc.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_SIZE_BYTES=5242880
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Public AI chatbot (Google Gemini). Keep the real key only in backend/.env (git-ignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# minimal | low | medium | high | default
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_SECONDS=20
# start the fallback model in parallel if no first token after this many seconds
GEMINI_HEDGE_AFTER_SECONDS=4
# public-knowledge cache lifetime (validated on every request; 0 disables)
CHAT_KNOWLEDGE_CACHE_SECONDS=60
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_MAX_MESSAGE_CHARS=1000
