# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./backend/data/smdpvc.db

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Admin Account Bootstrap (optional)
# If set, the backend will automatically create an initial admin account on startup
# if it doesn't already exist. Leave empty to skip automatic bootstrap.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smdpvc.school
ADMIN_PASSWORD=your-secure-admin-password-here

# Cloudinary Configuration (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload Configuration
MAX_UPLOAD_SIZE_BYTES=5242880

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
