# Optional: set these to provision a stable staff sign-in.
# In development, the server creates a random admin password on first launch
# when NURSERY_CALENDAR_ADMIN_PASSWORD is not set.
NURSERY_CALENDAR_ADMIN_EMAIL=admin@smdpvc.local
NURSERY_CALENDAR_ADMIN_PASSWORD=

# Optional persistent storage path. Defaults to .data/nursery-academic-calendar.
NURSERY_CALENDAR_STORAGE_DIR=
PORT=5173
