# Optional: set these to provision a stable staff sign-in.
# In development, the server creates a random admin password on first launch
# when NURSERY_CALENDAR_ADMIN_PASSWORD is not set.
NURSERY_CALENDAR_ADMIN_EMAIL=admin@smdpvc.local
NURSERY_CALENDAR_ADMIN_PASSWORD=

# Optional persistent storage path. Defaults to .data/nursery-academic-calendar.
NURSERY_CALENDAR_STORAGE_DIR=

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./backend/data/smdpvc.db

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Admin Account Bootstrap (optional)
# If set, the backend will automatically create an initial admin account on startup
# if it doesn't already exist. Leave empty to skip automatic bootstrap.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smdpvc.school
ADMIN_PASSWORD=your-secure-admin-password-here



# Upload Configuration
MAX_UPLOAD_SIZE_BYTES=5242880

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PORT=5173
